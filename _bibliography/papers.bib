@article{valdes_bobes_jmp_2025,
  title   = {Why Remote Work Stuck: A Structural Decomposition of the Post-Pandemic Equilibrium},
  author  = {Mitchell Valdes-Bobes and Anna Lukianova},
  year    = {2025},
  abstract = {The post-pandemic labor market featured a persistent increase in remote work arrangements. We ask whether this re-valuation of work is mostly due to a shift in worker preferences for flexibility or advances in technology that make remote work more feasible. We develop and estimate a general equilibrium search model featuring heterogeneity in worker skill and idiosyncratic worker tastes. A key innovation is our novel, continuous measure of occupational teleworkability, which allows the model to capture rich heterogeneity in remote-work potential across firms and occupations. We estimate the model's deep parameters via the Simulated Method of Moments (SMM), disciplined by rich microdata from two distinct periods: 2019 (pre-pandemic) and 2024 (post-pandemic). Our analysis reveals that the shift is overwhelmingly driven by a profound revaluation of in-office time by workers. A structural decomposition shows that this preference shock accounts for 56.8\% of the total increase in the average share of remote work, while concurrent shocks to remote work technology account for 33.0\% of the shift.},
  jmp = {true},
  pdf = {valdes_mitchell_jmp.pdf},
  slides = {valdes_mitchell_jmp_slides.pdf},
  code = {https://github.com/mitchv34/searching_flexibility}
}

@article{valdes_bobes_ai_2025,
  title   = {Automation and Augmentation: The Dual Impact of AI on the Labor Market},
  author  = {Mitchell Valdes-Bobes},
  year    = {2025},
  abstract = {This paper investigates the dual impact of Artificial Intelligence on the U.S. labor market. I distinguish between its capacity to automate tasks, displacing workers, and its ability to augment human capabilities, enhancing productivity. To quantify these distinct forces, I construct occupational-level exposure scores by mapping task-level data on AI capabilities to the O*NET occupational database and merge them with panel data on wages and employment. The underlying mechanism suggests that these two forces shape labor market outcomes unequally. The negative displacement effects from automation are likely to be more widespread and immediate, contributing to wage stagnation and increased job polarization, especially in routine cognitive professions. Conversely, a significant, though potentially more concentrated, wage premium is expected for workers in highly augmentable roles, suggesting that AI is creating a new class of 'winners' who can effectively partner with the technology.},
  jmp = {false}
}

@article{valdes_bobes_wage_inequality_2025,
  title   = {Industry Workforce Heterogeneity and Wage Inequality},
  author  = {Mitchell Valdes-Bobes},
  year    = {2025},
  abstract = {I reexamine the capital-skill complementarity hypothesis at the industry level as the driver of the increase in wage inequality between skilled and unskilled workers. Using the model proposed by Krusell, Ohanian Ríos-Rull, and Violante (2000), I decompose the growth of the skill premium into counteracting effects: (i) the negative effect in the relative price of skilled labor due to its relative increase in supply, and (ii) the positive effect of the increase in the marginal productivity of skilled workers relative to unskilled due to technological change (capital-skill complementarity). I show that for 78.6\% of the industries in the sample (22 out of 28 industries) the demand effect due to capital-skill complementarity dominates the supply effect. The analysis includes a comprehensive decomposition showing that equipment investment complementary to skilled labor more than offset the downward pressure from increased college graduate supply, driving up skill premiums across most industries.},
  jmp = {false},
  pdf = {valdes_mitchell_wage_inequality.pdf},
  slides = {valdes_mitchell_wage_inequality_slides.pdf},
  code = {https://github.com/mitchv34/industry_skill_premium}
}
