source "https://rubygems.org"

# Core Jekyll
gem "jekyll", "~> 4.0"
gem "bundler", "~> 2.6"

# Your site’s plugins
group :jekyll_plugins do
    # GitHub‑Pages–whitelisted functionality you still want
    gem "jekyll-feed"
    gem "jekyll-sitemap"
    gem "jemoji"
    gem "jekyll-coffeescript"
    gem "jekyll-gist"
    gem "jekyll-github-metadata"
    gem "jekyll-paginate"
    gem "jekyll-paginate-v2"
    gem "jekyll-relative-links"
    gem "jekyll-optional-front-matter"
    gem "jekyll-readme-index"
    gem "jekyll-default-layout"
    gem "jekyll-titles-from-headings"
    gem "kramdown-parser-gfm"
    # Your extra plugins & custom tags
    gem "jekyll-archives-v2"
    gem "jekyll-email-protect"
    gem "jekyll-get-json"
    gem "jekyll-imagemagick"
    gem "jekyll-link-attributes"
    gem "jekyll-minifier"
    gem "jekyll-regex-replace"
    gem "jekyll-tabs"
    gem "jekyll-terser", git: "https://github.com/RobertoJBeltran/jekyll-terser.git"
    gem "jekyll-toc"
    gem "bibtex-ruby", "~> 6.1.0"
    gem "jekyll-scholar", "~> 7.0"
    gem "jekyll-twitter-plugin"
    gem "feedjira"
    gem "classifier-reborn"
end

# Any supporting non‑Jekyll gems
group :other_plugins do
    gem "css_parser"
    gem "httparty"
    gem "observer"   # for jekyll-scholar
    gem "ostruct"    # for jekyll-twitter-plugin
    gem "faraday-retry" # for faraday v2.0+ support
end
